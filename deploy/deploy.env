# ============================================================
# Control de esquema/siembra para TODOS los MS backend.
# (No contiene secretos: las credenciales RDS salen de los
#  application.properties. Se puede versionar sin problema.)
#
# --- FASE 1: PRIMER ARRANQUE (siembra los datos) ---
# Deja estos valores activos para el primer 'up' de cada EC2.
DDL_AUTO=create
SPRING_SQL_INIT_MODE=always
#
# --- FASE 2: PERSISTENCIA (datos se mantienen entre reinicios) ---
# Cuando ya verificaste que hay datos en RDS, COMENTA las 2 líneas
# de arriba, DESCOMENTA estas 2, y vuelve a hacer 'up -d' en cada EC2.
# DDL_AUTO=update
# SPRING_SQL_INIT_MODE=never
# ============================================================

# Límite de conexiones por MS a RDS. 8 MS x 5 = 40 conexiones, bajo el
# max_connections del RDS (~66 en db.t3.micro). Evita "Too many connections".
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5

# Rotación de credenciales RDS (opcional; por defecto salen de properties):
# DB_USERNAME=admin
# DB_PASSWORD=My_ohiggins2026
